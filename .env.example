# ============================================================================
# 1. TELEGRAM CONFIGURATION (Required)
# ============================================================================
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your numeric Telegram Chat ID (get from @userinfobot). If set, restricts bot to you
# and sends scheduled GitHub Actions notifications to this chat ID automatically.
TELEGRAM_CHAT_ID=123456789

# Default sets to auto-subscribe on first startup (format: SET_NUM:MIN:MAX, use - for skip)
# Example: 10316:-:1750,75192:2200:2900,42154:-:-
DEFAULT_SUBSCRIPTIONS=

# ============================================================================
# 2. SCHEDULER & DATABASE CONFIGURATION
# ============================================================================
# Path to SQLite database file
DATABASE_PATH=data/lego_tracker.db
# Price check interval in minutes (default: 5)
PRICE_CHECK_INTERVAL_MINUTES=5
# Retirement date check interval in days (default: 5)
RETIREMENT_CHECK_INTERVAL_DAYS=5

# ============================================================================
# 3. ANTI-BLOCKING / PROXY CONFIGURATION (Optional, Recommended for GitHub Actions)
# ============================================================================
# Comma-separated list of HTTP/SOCKS5 proxies (e.g. http://user:pass@host:port)
PROXY_URLS=
# Optional free Cloudflare Worker URL to relay requests from GitHub Actions Azure IPs
# Deploy cloudflare_worker_proxy.js to Cloudflare Workers (100,000 free requests/day)
CF_WORKER_PROXY_URL=
CF_WORKER_SECRET=

# Delay jitter between requests to the same domain (seconds)
MIN_DOMAIN_DELAY_SEC=1.2
MAX_DOMAIN_DELAY_SEC=3.0

# ============================================================================
# 4. OPTIONAL OFFICIAL MARKETPLACE API KEYS (Enhances stability over scraping)
# ============================================================================
# Allegro REST API (https://apps.developer.allegro.pl/) - Free account
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=

# eBay Browse API (https://developer.ebay.com/) - Free account
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Brickset API v3 Key (https://brickset.com/tools/webservices/requestkey) - Free
BRICKSET_API_KEY=

# BrickLink OAuth1 API (https://www.bricklink.com/v2/api/register_consumer.page)
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN_VALUE=
BRICKLINK_TOKEN_SECRET=
